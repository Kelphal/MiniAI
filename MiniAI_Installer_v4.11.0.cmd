setlocal EnableExtensions DisableDelayedExpansion
title MiniAI Installer - v4.11.0 - Kelphal - Gio A.
echo Preparing MiniAI v4.11.0 installer by Kelphal - Gio A....
set "TMPROOT=%TEMP%\MiniAI_%RANDOM%%RANDOM%"
