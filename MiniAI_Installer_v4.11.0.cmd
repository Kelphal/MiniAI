if errorlevel 1 goto :fail
if not exist "%ZIPFILE%" goto :fail
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; Add-Type -AssemblyName System.IO.Compression.FileSystem; $out=$env:MINIAI_ZIP; $root=Join-Path $env:TEMP ('MiniAI_Install_'+[guid]::NewGuid().ToString('N')); New-Item -ItemType Directory -Path $root | Out-Null; [IO.Compression.ZipFile]::ExtractToDirectory($out,$root); $installer=Join-Path $root 'Install_MiniAI.ps1'; if(!(Test-Path -LiteralPath $installer)){throw 'Install_MiniAI.ps1 was not found after extraction.'}; & powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File $installer; exit $LASTEXITCODE"
