if exist "%TMPROOT%" rmdir /s /q "%TMPROOT%" >nul 2>&1
mkdir "%TMPROOT%" >nul 2>&1
if not exist "%TMPROOT%" goto :fail
set "MINIAI_SELF=%~f0"
set "MINIAI_ZIP=%ZIPFILE%"
